import json
import pandas as pd

# 1. Load the JSON file
with open("catboost_training.json", "r") as f:
    data = json.load(f)

# 2. Extract the iterations list
iters = data["iterations"]

# 3. Flatten into a DataFrame
#    Each entry has keys: 'iteration', 'passed_time', 'remaining_time'
#    plus nested lists under 'learn' and 'test'
rows = []
for entry in iters:
    rows.append({
        "iteration":       entry["iteration"],
        "train_rmse":      entry["learn"][0],     # first element in the 'learn' list
        "test_rmse":       entry["test"][0],      # first element in the 'test'  list
        "passed_time_s":   entry["passed_time"], 
        "remaining_time_s":entry["remaining_time"]
    })

df = pd.DataFrame(rows)
print(df.head())


import plotly.express as px

fig = px.parallel_coordinates(
    df,
    color="test_rmse",                     # color lines by test RMSE
    dimensions=[
        "iteration",
        "train_rmse",
        "test_rmse",
        "passed_time_s",
        "remaining_time_s"
    ],
    color_continuous_scale=px.colors.sequential.Viridis_r,
    labels={
        "iteration":        "Boost Round",
        "train_rmse":       "Train RMSE",
        "test_rmse":        "Test RMSE",
        "passed_time_s":    "Time Elapsed (s)",
        "remaining_time_s":"Time Remaining (s)"
    },
    title="CatBoost Training Dynamics Over Iterations"
)

fig.update_layout(
    plot_bgcolor="white",
    title_x=0.5,
    font=dict(size=12)
)

fig.show()



