import re
import pandas as pd

# 1) Read the entire log
with open("mlp_log.txt", "r", encoding="utf-8") as f:
    text = f.read()

# 2) Find all epochs and their metrics
pattern = (
    r"Epoch\s+(\d+)/\d+.*?"
    r"-\s*loss:\s*([\d\.]+)\s*-\s*rmse:\s*([\d\.]+)\s*"
    r"-\s*val_loss:\s*([\d\.]+)\s*-\s*val_rmse:\s*([\d\.]+)"
)
rows = []
for m in re.finditer(pattern, text, re.DOTALL):
    epoch, loss, rmse, val_loss, val_rmse = m.groups()
    rows.append({
        "epoch":       int(epoch),
        "loss":        float(loss),
        "train_rmse":  float(rmse),
        "val_loss":    float(val_loss),
        "val_rmse":    float(val_rmse)
    })

# 3) Dump to a CSV
df = pd.DataFrame(rows).sort_values("epoch")
df.to_csv("mlp_epochs.csv", index=False)
print("Wrote mlp_epochs.csv with columns:", df.columns.tolist())
print(df.head())


import pandas as pd
import plotly.graph_objects as go
from plotly.subplots import make_subplots

# Load the epochs CSV
df = pd.read_csv("mlp_epochs.csv")

# Create a subplot figure with 2 rows: Loss and RMSE
fig = make_subplots(rows=2, cols=1, shared_xaxes=True, 
                    subplot_titles=("Loss vs. Epoch", "RMSE vs. Epoch"))

# Add training and validation loss to first subplot
fig.add_trace(go.Scatter(x=df['epoch'], y=df['loss'], mode='lines+markers',
                         name='Train Loss', line=dict(dash='solid', color='blue')),
              row=1, col=1)
fig.add_trace(go.Scatter(x=df['epoch'], y=df['val_loss'], mode='lines+markers',
                         name='Val Loss', line=dict(dash='dash', color='orange')),
              row=1, col=1)

# Add training and validation RMSE to second subplot
fig.add_trace(go.Scatter(x=df['epoch'], y=df['train_rmse'], mode='lines+markers',
                         name='Train RMSE', line=dict(dash='solid', color='green')), 
              row=2, col=1)
fig.add_trace(go.Scatter(x=df['epoch'], y=df['val_rmse'], mode='lines+markers',
                         name='Val RMSE', line=dict(dash='dash', color='red')), 
              row=2, col=1)

# Update layout for readability
fig.update_layout(
    height=600, width=800,
    title_text="MLP Training Progress Over Epochs",
    legend=dict(orientation="h", yanchor="top", y=1.1, xanchor="center", x=0.5),
    margin=dict(t=100)
)

# Update axes labels
fig.update_xaxes(title_text="Epoch", row=2, col=1)
fig.update_yaxes(title_text="Loss", row=1, col=1)
fig.update_yaxes(title_text="RMSE", row=2, col=1)

fig.show()



