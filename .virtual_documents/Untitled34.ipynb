import wandb
import pandas as pd
import plotly.express as px

# 1) Read your CatBoost Optuna trials CSV
df = pd.read_csv(
    "data/processed/catboost_trials.csv",
    sep=";",                 # <— tell pandas to use semicolons
    engine="python"          # more forgiving parser
)

# 2) Start a new W&B run
run = wandb.init(
    project="Phase1_trial_plots",
    name="catboost_parcoords",
    config={"notes": "CatBoost Optuna sweep, phase1"}
)

# 3) Build a Plotly parallel-coordinates figure
fig = px.parallel_coordinates(
    df,
    color="value",    # your validation RMSE column
    dimensions=[
        "learning_rate",    # column from CSV
        "depth",
        "subsample",
        "colsample_bylevel",
        "value"
    ],
    color_continuous_scale=px.colors.sequential.Viridis_r,
    labels={
        "learning_rate":     "Learning Rate",
        "depth":             "Depth",
        "subsample":         "Subsample",
        "colsample_bylevel": "Col Sample",
        "value":             "Val RMSE"
    },
    title="CatBoost Optuna Trials: Hyperparams ↔ Validation RMSE"
)

# 4) Log the Plotly figure to W&B
wandb.log({"catboost_optuna_parallel_coordinates": fig})

# 5) Finish the run
run.finish()


import pandas as pd
import io

# 1) Read raw text so we can inspect line counts
with open("data/processed/catboost_trials.csv", "r") as f:
    lines = [l for l in f.readlines() if l.strip() != ""]
print(f"Total non-blank lines: {len(lines)}")

# 2) Show the first few lines so we can verify the header/field count
for i, line in enumerate(lines[:10]):
    print(f"{i:2d}> {repr(line)}")

# 3) Now read it with pandas, skipping any truly bad lines
df = pd.read_csv(
    io.StringIO("".join(lines)),  # feed only the non-blank lines
    sep=",",
    engine="python",
    skip_blank_lines=True,
    on_bad_lines="warn"            # will warn if any line is malformed
)

print("\nLoaded DataFrame:")
print(df.head(), "\nColumns:", df.columns.tolist())



